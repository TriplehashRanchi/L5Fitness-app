{
  "expo": {
    "name": "L5 Fitness",
    "slug": "L5Fitness-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "l5fitnessapp",
    "userInterfaceStyle": "dark",
    "ios": {
      "infoPlist": {}
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#C6F432",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.health.READ_STEPS"
      ],
      "package": "com.level5fitness.app",
      "googleServicesFile": "./google-services.json"
    },
    "web": {
      "output": "server",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0B0B0D",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 110
        }
      ],
      "expo-localization",
      "expo-secure-store",
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 26
          }
        }
      ],
      "react-native-health-connect",
      [
        "@kingstinct/react-native-healthkit",
        {
          "NSHealthShareUsageDescription": "We read your daily steps to show your fitness progress.",
          "NSHealthUpdateUsageDescription": "L5 Fitness does not save anything to Apple Health.",
          "background": false
        }
      ],
      "react-native-nitro-google-signin",
      [
        "expo-image-picker",
        {
          "photosPermission": "L5 Fitness uses your photos so you can add pictures of your meals.",
          "cameraPermission": "L5 Fitness uses your camera so you can take pictures of your meals.",
          "microphonePermission": false
        }
      ],
      "@react-native-community/datetimepicker"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "backgroundColor": "#0B0B0D",
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "ae2a7cc1-2aaf-4b48-865a-e848aa92e0a3"
      }
    },
    "owner": "gautampandit"
  }
}
