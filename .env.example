# Copy to .env.local. Only EXPO_PUBLIC_ values belong here: they are visible inside the app.
# Never put database, storage or auth secrets in this app.
EXPO_PUBLIC_API_URL=http://localhost:4000

# Firebase (Project settings → Your apps → Web app → config). Fill in at the end.
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=
# "Web client ID" shown in Firebase → Authentication → Sign-in method → Google → Web SDK configuration
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
